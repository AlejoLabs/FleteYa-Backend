# ─────────────────────────────────────────────
#  Base de datos (MySQL / MariaDB)
# ─────────────────────────────────────────────
# Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/apirestnodejs"

# ─────────────────────────────────────────────
#  Servidor
# ─────────────────────────────────────────────
HOST=localhost
PORT=3000

# ─────────────────────────────────────────────
#  Autenticación JWT
# ─────────────────────────────────────────────
# Clave secreta para firmar los tokens. Usa una cadena larga y aleatoria.
JWT_SECRET=tu_clave_secreta_aqui

# ─────────────────────────────────────────────
#  Google Maps
# ─────────────────────────────────────────────
# API Key obtenida desde https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=tu_api_key_aqui
