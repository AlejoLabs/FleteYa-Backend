# ─────────────────────────────────────────────
#  Base de datos (MySQL / MariaDB)
# ─────────────────────────────────────────────
# Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/apirestnodejs"

# ─────────────────────────────────────────────
#  Servidor
# ─────────────────────────────────────────────
HOST=localhost
PORT=3000

# ─────────────────────────────────────────────
#  Autenticación JWT
# ─────────────────────────────────────────────
# Clave secreta para firmar los tokens. Usa una cadena larga y aleatoria.
JWT_SECRET=tu_clave_secreta_aqui

# ─────────────────────────────────────────────
#  Google Maps
# ─────────────────────────────────────────────
# API Key obtenida desde https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=tu_api_key_aqui

# ─────────────────────────────────────────────
#  Correo (códigos para restablecer contraseña)
# ─────────────────────────────────────────────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una contraseña de aplicación en SMTP_PASS.
# Si no se configura, en desarrollo el código se imprime en la consola del backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
MAIL_FROM="FleteYa <tu_correo@gmail.com>"

# ─────────────────────────────────────────────
#  Entrar con Google
# ─────────────────────────────────────────────
# ID de cliente "Aplicación web" de Google Cloud (el mismo que EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID de la app)
GOOGLE_WEB_CLIENT_ID=tu_id.apps.googleusercontent.com

# ─────────────────────────────────────────────
#  Pruebas (npm test)
# ─────────────────────────────────────────────
# Un cliente y un conductor (vehículo de estacas) que ya existan en la base local
TEST_CLIENT_EMAIL=cliente@ejemplo.com
TEST_DRIVER_EMAIL=conductor@ejemplo.com
TEST_PASSWORD=contraseña_de_prueba

# ─────────────────────────────────────────────
#  Pagos (Fase 7)
# ─────────────────────────────────────────────
# Llaves de Wompi (panel de comercios → Desarrolladores). Las de prueba empiezan por pub_test_ / prv_test_ / test_integrity_
# y usan el sandbox, sin dinero real. Activar el comercio pide RUT y cuenta bancaria.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
# Sin llaves de Wompi y con esto en true, "Pagar por la app" abre el simulador del backend (/payments/simulator)
PAYMENTS_SIMULATOR=true
