// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id Int @id @default(autoincrement())
  name String
  lastname String
  email String @unique
  phone String
  image String?
  password String
  notification_token String?
  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  roles UserHasRole[]
  driverPosition DriverPosition?


  client ClientRequests[] @relation("client")
  driver ClientRequests[] @relation("driver")
  driverTripOffers DriverTripOffer[] @relation("DriverTripOffers")

  @@map("users")

}

model Role {

  id String @id
  name String @unique @db.VarChar(25)
  image String @db.VarChar(255)
  route String @db.VarChar(255)
  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  users UserHasRole[]

  @@map("roles")
}

model UserHasRole {
  id_user Int
  id_rol String

  user User @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [id_rol], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([id_user, id_rol])
  @@map("user_has_roles")
}

model DriverPosition {
  id_driver Int @id
  user User @relation(fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)

  position Unsupported("POINT")

  @@map("drivers_position")
}

model TimeAndDistanceValues {
  id          Int   @id
  km_value    Float
  min_value   Float
  weight_rate Float
  size_rate   Float

  @@map("time_and_distance_values")
}

model ClientRequests {
  id Int @id @default(autoincrement())

  id_client Int
  id_driver_assigned Int?

  client User @relation("client", fields: [id_client], references: [id])
  driver User? @relation("driver", fields: [id_driver_assigned], references: [id])

  fare_offered Float
  fare_assigned Float?

  client_rating Float?
  driver_rating Float?

  pickup_description String @db.VarChar(255)
  destination_description String @db.VarChar(255)
  cargo_description String? @db.VarChar(255)

  pickup_position Unsupported("POINT")
  destination_position Unsupported("POINT")

  status ClientRequestStatus @default(CREATED)

  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  driverTripOffers DriverTripOffer[]

  @@map("client_requests")
  
}

enum ClientRequestStatus {
  CREATED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  TRAVELING
  FINISHED
  CANCELED
}

model DriverTripOffer {
  id Int @id @default(autoincrement())

  id_driver Int
  id_client_request Int

  fare_offered Float
  time Float
  distance Float

  created_at DateTime @default(now())
  update_at DateTime @updatedAt
  
  driver User @relation("DriverTripOffers", fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)
  client_request ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("driver_trip_offers")
}