// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id Int @id @default(autoincrement())
  name String
  lastname String
  email String @unique
  phone String
  image String?
  // null en cuentas creadas con Google: pueden crear una contraseña con "¿Olvidaste tu contraseña?"
  password String?
  // Cuenta de Google vinculada (el "sub" del token de Google)
  google_id String? @unique @db.VarChar(64)
  // true cuando el correo se comprobó: entró con Google o restableció la contraseña con el código
  email_verified Boolean @default(false)
  // Token de Firebase Cloud Messaging del teléfono donde tiene la sesión abierta; null al cerrar sesión
  notification_token String? @db.VarChar(255)
  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  roles UserHasRole[]
  driverPosition DriverPosition?
  passwordResetCodes PasswordResetCode[]
  tripPhotos TripPhoto[]
  tripMessages TripMessage[]
  incidentReports IncidentReport[]


  client ClientRequests[] @relation("client")
  driver ClientRequests[] @relation("driver")
  driverTripOffers DriverTripOffer[] @relation("DriverTripOffers")
  driverCarInfo DriverCarInfo?
  dismissedRequests DriverDismissedRequest[]
  adminActions AdminAction[] @relation("admin")

  // ACTIVE: usa la app. SUSPENDED: el admin la bloqueó; cada petición y su socket se cortan al instante
  status UserStatus @default(ACTIVE)
  // Motivo de la suspensión (lo ve la persona al intentar entrar)
  status_reason String? @db.VarChar(255)
  // Datos personales borrados a pedido del usuario (Ley 1581): los viajes se conservan sin nombre, correo ni celular
  anonymized_at DateTime?

  @@map("users")

}

model Role {

  id String @id
  name String @unique @db.VarChar(25)
  image String @db.VarChar(255)
  route String @db.VarChar(255)
  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  users UserHasRole[]

  @@map("roles")
}

model UserHasRole {
  id_user Int
  id_rol String

  user User @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [id_rol], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([id_user, id_rol])
  @@map("user_has_roles")
}

model DriverPosition {
  id_driver Int @id
  user User @relation(fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)

  position Unsupported("POINT")

  @@map("drivers_position")
}

model TimeAndDistanceValues {
  id          Int   @id
  km_value    Float
  min_value   Float
  weight_rate Float
  size_rate   Float
  // Parte del valor acordado que se queda FleteYa (0.1 = 10 %). Cada viaje guarda la suya al asignarse
  commission_rate Float @default(0.1)

  @@map("time_and_distance_values")
}

// Tarifa de cada tipo de vehículo para el precio sugerido: un valor base más un factor sobre distancia y tiempo
model VehicleRate {
  vehicle_type VehicleType @id
  base_fare    Float
  km_factor    Float

  @@map("vehicle_rates")
}

model ClientRequests {
  id Int @id @default(autoincrement())

  id_client Int
  id_driver_assigned Int?

  client User @relation("client", fields: [id_client], references: [id])
  driver User? @relation("driver", fields: [id_driver_assigned], references: [id])

  fare_offered Float
  fare_assigned Float?

  client_rating Float?
  driver_rating Float?

  pickup_description String @db.VarChar(255)
  destination_description String @db.VarChar(255)
  cargo_description String? @db.VarChar(255)

  weight_kg Float?
  height_cm Float?
  width_cm  Float?
  length_cm Float?

  // Carga: categoría general, bultos y marcas de manejo
  cargo_category CargoCategory @default(OTRO)
  packages Int @default(1)
  is_fragile Boolean @default(false)
  needs_cover Boolean @default(false)

  // Vehículo mínimo en el que cabe la carga; solo la ven conductores con un vehículo igual o más grande
  required_vehicle VehicleType @default(CARRY)

  // Cargue y descargue
  helpers Int @default(0)
  pickup_floor Int?
  pickup_has_elevator Boolean?
  destination_floor Int?
  destination_has_elevator Boolean?

  // Contactos de entrega, cuando no es el cliente quien entrega o recibe
  sender_name String? @db.VarChar(100)
  sender_phone String? @db.VarChar(20)
  receiver_name String? @db.VarChar(100)
  receiver_phone String? @db.VarChar(20)

  // null = "Ahora". Pasado expires_at sin conductor asignado, la solicitud vence
  scheduled_at DateTime?
  expires_at DateTime?

  canceled_by Int?
  cancel_reason String? @db.VarChar(255)

  // Pago: se cobra al terminar el viaje, en efectivo o por Wompi. La comisión se fija al asignar el conductor,
  // para que un cambio de tarifa no altere viajes ya acordados. paid_at null = sin pagar
  payment_method PaymentMethod @default(CASH)
  commission_rate Float?
  commission Float?
  paid_at DateTime?
  // Viaje en efectivo: el conductor se quedó con todo y le debe la comisión a FleteYa hasta que el admin la liquida.
  // En los pagos por la app la comisión se retiene sola
  commission_settled_at DateTime?
  // Valor aproximado de la carga que declara el cliente. Informativo, base para un seguro futuro
  declared_value Float?

  // Prueba de entrega: código de 4 dígitos que quien recibe le dicta al conductor. Solo lo ve el cliente
  delivery_code String? @db.Char(4)
  delivery_code_attempts Int @default(0)
  // Recordatorio push del flete programado, para no mandarlo dos veces
  reminder_sent_at DateTime?

  pickup_position Unsupported("POINT")
  destination_position Unsupported("POINT")

  status ClientRequestStatus @default(CREATED)

  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  driverTripOffers DriverTripOffer[]
  dismissedBy DriverDismissedRequest[]
  photos TripPhoto[]
  messages TripMessage[]
  incidents IncidentReport[]
  payments Payment[]

  @@index([status, expires_at])
  @@map("client_requests")
}

enum ClientRequestStatus {
  CREATED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  TRAVELING
  FINISHED
  CANCELED
  EXPIRED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

// De menor a mayor capacidad; el orden importa para saber si una carga cabe
enum VehicleType {
  CARRY
  ESTACAS
  FURGON
  CAMION
}

enum PaymentMethod {
  CASH
  WOMPI
}

// Los mismos estados de una transacción de Wompi; el efectivo nace APPROVED cuando el conductor lo confirma
enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

// Cada intento de pago de un viaje. Un pago rechazado deja su fila y el cliente puede intentar otra vez con otra referencia
model Payment {
  id Int @id @default(autoincrement())
  id_client_request Int
  // Referencia única que viaja a Wompi y vuelve en la transacción
  reference String @unique @db.VarChar(64)
  method PaymentMethod
  amount Int
  status PaymentStatus @default(PENDING)
  wompi_transaction_id String? @db.VarChar(64)
  // NEQUI, CARD, PSE, BANCOLOMBIA_TRANSFER... según lo que eligió el cliente en el checkout
  wompi_method String? @db.VarChar(40)
  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  clientRequest ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([id_client_request, created_at])
  @@map("payments")
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// Cada acción del panel de administración: quién hizo qué, sobre qué y cuándo
model AdminAction {
  id          Int      @id @default(autoincrement())
  id_admin    Int
  // SUSPEND_USER, APPROVE_DRIVER, UPDATE_RATES, ...
  action      String   @db.VarChar(40)
  target_type String   @db.VarChar(30)
  target_id   Int?
  detail      String?  @db.VarChar(500)
  created_at  DateTime @default(now())

  admin User @relation("admin", fields: [id_admin], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([created_at])
  @@map("admin_actions")
}

// Código de 6 dígitos para restablecer la contraseña. Se guarda solo su hash; vence y tiene intentos limitados
model PasswordResetCode {
  id Int @id @default(autoincrement())
  id_user Int
  code_hash String @db.VarChar(64)
  expires_at DateTime
  attempts Int @default(0)
  used_at DateTime?
  created_at DateTime @default(now())

  user User @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_user, created_at])
  @@map("password_reset_codes")
}

enum CargoCategory {
  MUDANZA
  MERCANCIA
  MATERIALES
  MAQUINARIA
  ELECTRODOMESTICOS
  OTRO
}

model DriverTripOffer {
  id Int @id @default(autoincrement())

  id_driver Int
  id_client_request Int

  fare_offered Float
  time Float
  distance Float
  status OfferStatus @default(PENDING)

  created_at DateTime @default(now())
  update_at DateTime @updatedAt
  
  driver User @relation("DriverTripOffers", fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)
  client_request ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_client_request, status])
  @@map("driver_trip_offers")
}

// Solicitudes que un conductor marcó como "No me interesa": no se le vuelven a mostrar
model DriverDismissedRequest {
  id_driver Int
  id_client_request Int
  created_at DateTime @default(now())

  driver User @relation(fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)
  client_request ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([id_driver, id_client_request])
  @@map("driver_dismissed_requests")
}

model DriverCarInfo {

  id_driver Int @id
  brand String @db.VarChar(50)
  color String @db.VarChar(50)
  plate String @db.VarChar(20)
  // Los conductores que ya existían quedan con camioneta de estacas; los nuevos lo eligen al registrarse
  vehicle_type VehicleType @default(ESTACAS)
  model_year Int?
  // Carrocería cerrada (furgón, carpa) o abierta (estacas, platón)
  is_covered Boolean @default(false)
  // Capacidad real cuando el vehículo es más grande que el típico de su tipo (un furgón de 30 m³). null = la típica
  capacity_kg Int?
  capacity_m3 Float?

  // Documentos con su vencimiento; la app avisa antes de que venzan
  license_number String? @db.VarChar(30)
  license_category String? @db.VarChar(3)
  license_expires_at DateTime?
  soat_expires_at DateTime?
  techno_expires_at DateTime?
  property_card_number String? @db.VarChar(30)

  // Los conductores nuevos esperan a que el admin revise vehículo y documentos. Solo los APPROVED con documentos
  // vigentes ven y ofertan fletes (los que ya existían antes de la Fase 8 quedaron aprobados)
  approval_status DriverApprovalStatus @default(PENDING)
  // Motivo del rechazo, que el conductor ve en la app
  approval_note String? @db.VarChar(255)
  reviewed_at DateTime?

  // Último aviso push de documentos por vencer; se repite como mucho una vez por semana
  documents_reminded_at DateTime?

  driver User @relation( fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)
  photos VehiclePhoto[]

  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  @@map("driver_car_info")

}
// CARGO: el cliente muestra la carga al pedir el flete. PICKUP y DELIVERY: el conductor la fotografía al cargar y al entregar
enum TripPhotoKind {
  CARGO
  PICKUP
  DELIVERY
}

// Las fotos se guardan fuera de public/: solo se sirven a quien puede ver el viaje
model TripPhoto {
  id Int @id @default(autoincrement())
  id_client_request Int
  id_user Int
  kind TripPhotoKind
  file_name String @db.VarChar(100)
  created_at DateTime @default(now())

  client_request ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user User @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_client_request, kind])
  @@map("trip_photos")
}

// Fotos del vehículo del conductor, para que el cliente vea qué le llega y el admin lo verifique (Fase 8)
model VehiclePhoto {
  id Int @id @default(autoincrement())
  id_driver Int
  file_name String @db.VarChar(100)
  created_at DateTime @default(now())

  car DriverCarInfo @relation(fields: [id_driver], references: [id_driver], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_driver])
  @@map("vehicle_photos")
}

// Chat del viaje entre el cliente y el conductor asignado, para no tener que compartir el celular
model TripMessage {
  id Int @id @default(autoincrement())
  id_client_request Int
  id_sender Int
  text String @db.VarChar(500)
  // Cuándo lo leyó el otro; null = sin leer
  read_at DateTime?
  created_at DateTime @default(now())

  client_request ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sender User @relation(fields: [id_sender], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_client_request, id])
  @@map("trip_messages")
}

enum IncidentKind {
  DAMAGE
  LOSS
  DELAY
  BEHAVIOR
  OTHER
}

// OPEN al crearlo; el administrador lo revisa y lo cierra desde el panel (Fase 8)
enum IncidentStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

// Daño, pérdida u otro problema que reporta el cliente o el conductor sobre un viaje
model IncidentReport {
  id Int @id @default(autoincrement())
  id_client_request Int
  id_reporter Int
  kind IncidentKind
  description String @db.VarChar(1000)
  status IncidentStatus @default(OPEN)
  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  client_request ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reporter User @relation(fields: [id_reporter], references: [id], onDelete: Cascade, onUpdate: Cascade)
  photos IncidentPhoto[]

  @@index([id_client_request, id_reporter])
  @@index([status])
  @@map("incident_reports")
}

model IncidentPhoto {
  id Int @id @default(autoincrement())
  id_incident Int
  file_name String @db.VarChar(100)
  created_at DateTime @default(now())

  incident IncidentReport @relation(fields: [id_incident], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_incident])
  @@map("incident_photos")
}
