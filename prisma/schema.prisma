// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id Int @id @default(autoincrement())
  name String
  lastname String
  email String @unique
  phone String
  image String?
  password String
  notification_token String?
  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  roles UserHasRole[]
  driverPosition DriverPosition?


  client ClientRequests[] @relation("client")
  driver ClientRequests[] @relation("driver")
  driverTripOffers DriverTripOffer[] @relation("DriverTripOffers")
  driverCarInfo DriverCarInfo?
  dismissedRequests DriverDismissedRequest[]

  @@map("users")

}

model Role {

  id String @id
  name String @unique @db.VarChar(25)
  image String @db.VarChar(255)
  route String @db.VarChar(255)
  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  users UserHasRole[]

  @@map("roles")
}

model UserHasRole {
  id_user Int
  id_rol String

  user User @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [id_rol], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([id_user, id_rol])
  @@map("user_has_roles")
}

model DriverPosition {
  id_driver Int @id
  user User @relation(fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)

  position Unsupported("POINT")

  @@map("drivers_position")
}

model TimeAndDistanceValues {
  id          Int   @id
  km_value    Float
  min_value   Float
  weight_rate Float
  size_rate   Float

  @@map("time_and_distance_values")
}

model ClientRequests {
  id Int @id @default(autoincrement())

  id_client Int
  id_driver_assigned Int?

  client User @relation("client", fields: [id_client], references: [id])
  driver User? @relation("driver", fields: [id_driver_assigned], references: [id])

  fare_offered Float
  fare_assigned Float?

  client_rating Float?
  driver_rating Float?

  pickup_description String @db.VarChar(255)
  destination_description String @db.VarChar(255)
  cargo_description String? @db.VarChar(255)

  weight_kg Float?
  height_cm Float?
  width_cm  Float?
  length_cm Float?

  // Carga: categoría general, bultos y marcas de manejo
  cargo_category CargoCategory @default(OTRO)
  packages Int @default(1)
  is_fragile Boolean @default(false)
  needs_cover Boolean @default(false)

  // Vehículo mínimo en el que cabe la carga; solo la ven conductores con un vehículo igual o más grande
  required_vehicle VehicleType @default(CARRY)

  // Cargue y descargue
  helpers Int @default(0)
  pickup_floor Int?
  pickup_has_elevator Boolean?
  destination_floor Int?
  destination_has_elevator Boolean?

  // Contactos de entrega, cuando no es el cliente quien entrega o recibe
  sender_name String? @db.VarChar(100)
  sender_phone String? @db.VarChar(20)
  receiver_name String? @db.VarChar(100)
  receiver_phone String? @db.VarChar(20)

  // null = "Ahora". Pasado expires_at sin conductor asignado, la solicitud vence
  scheduled_at DateTime?
  expires_at DateTime?

  canceled_by Int?
  cancel_reason String? @db.VarChar(255)

  pickup_position Unsupported("POINT")
  destination_position Unsupported("POINT")

  status ClientRequestStatus @default(CREATED)

  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  driverTripOffers DriverTripOffer[]
  dismissedBy DriverDismissedRequest[]

  @@index([status, expires_at])
  @@map("client_requests")
}

enum ClientRequestStatus {
  CREATED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  TRAVELING
  FINISHED
  CANCELED
  EXPIRED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

// De menor a mayor capacidad; el orden importa para saber si una carga cabe
enum VehicleType {
  CARRY
  ESTACAS
  FURGON
  CAMION
}

enum CargoCategory {
  MUDANZA
  MERCANCIA
  MATERIALES
  MAQUINARIA
  ELECTRODOMESTICOS
  OTRO
}

model DriverTripOffer {
  id Int @id @default(autoincrement())

  id_driver Int
  id_client_request Int

  fare_offered Float
  time Float
  distance Float
  status OfferStatus @default(PENDING)

  created_at DateTime @default(now())
  update_at DateTime @updatedAt
  
  driver User @relation("DriverTripOffers", fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)
  client_request ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_client_request, status])
  @@map("driver_trip_offers")
}

// Solicitudes que un conductor marcó como "No me interesa": no se le vuelven a mostrar
model DriverDismissedRequest {
  id_driver Int
  id_client_request Int
  created_at DateTime @default(now())

  driver User @relation(fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)
  client_request ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([id_driver, id_client_request])
  @@map("driver_dismissed_requests")
}

model DriverCarInfo {

  id_driver Int @id
  brand String @db.VarChar(50)
  color String @db.VarChar(50)
  plate String @db.VarChar(20)
  // Los conductores que ya existían quedan con camioneta de estacas; en la Fase 4 lo eligen al registrarse
  vehicle_type VehicleType @default(ESTACAS)

  driver User @relation( fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_at DateTime @default(now())
  update_at DateTime @updatedAt

  @@map("driver_car_info")

}