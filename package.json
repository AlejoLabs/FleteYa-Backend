    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
